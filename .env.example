# ==============================================================================
# ENVIRONMENT VARIABLES: WEB SISTEM KEAMANAN & THREAT INTELLIGENCE
# ==============================================================================

# 1. VERCEL CI/CD CREDENTIALS (Required for GitHub Actions Secrets)
# Dapatkan VERCEL_TOKEN di: https://vercel.com/account/tokens
# Dapatkan VERCEL_ORG_ID & VERCEL_PROJECT_ID di: Project Settings -> General
VERCEL_TOKEN=your_vercel_personal_access_token_here
VERCEL_ORG_ID=your_vercel_org_or_user_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# 2. HMAC-SHA256 WEBHOOK SECRET
# Kunci rahasia untuk memvalidasi cryptographic signature dari Supabase / Client
WEBHOOK_SECRET=cyber_soc_secure_hmac_secret_2026_key_super_safe

# 3. TELEGRAM ALERT BOT CREDENTIALS
# Buat bot via @BotFather di Telegram untuk mendapatkan bot token
TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJklMnOpQrStUvWxYz_SAMPLE_TOKEN
# Chat ID atau Group ID tujuan alert (contoh: -100123456789 atau 12345678)
TELEGRAM_CHAT_ID=-1001234567890

# 4. OPTIONAL: NVIDIA NIM & SUPABASE INTEGRATION
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
